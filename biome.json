{
  "$schema": "https://biomejs.dev/schemas/2.5.2/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "ignoreUnknown": true,
    "includes": [
      "**",
      "!**/styles/fontawesome-free-6.5.2-web",
      "!node_modules",
      "!.next",
      "!dist",
      "!build"
    ]
  },
  "formatter": {
    "enabled": true,
    "formatWithErrors": false,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineEnding": "lf",
    "lineWidth": 100,
    "attributePosition": "auto",
    "bracketSameLine": false,
    "bracketSpacing": true,
    "expand": "auto",
    "useEditorconfig": true,
    "includes": [
      "**",
      "!**/styles/fontawesome-free-6.5.2-web",
      "!**/node_modules",
      "!**/.pnp",
      "!**/.pnp.js",
      "!**/coverage",
      "!**/.next",
      "!**/out",
      "!**/build",
      "!**/storybook-static",
      "!**/playwright-report",
      "!**/.nyc_output",
      "!**/test-results",
      "!**/.DS_Store",
      "!**/*.pem",
      "!**/*.log",
      "!**/.prettierignore",
      "!**/.eslintignore",
      "!**/npm-debug.log*",
      "!**/yarn-debug.log*",
      "!**/yarn-error.log*",
      "!**/.env*.local",
      "!**/*.tsbuildinfo",
      "!**/next-env.d.ts"
    ]
  },
  "javascript": {
    "formatter": {
      "jsxQuoteStyle": "double",
      "quoteProperties": "asNeeded",
      "trailingCommas": "all",
      "semicolons": "always",
      "arrowParentheses": "always",
      "bracketSameLine": false,
      "quoteStyle": "single",
      "attributePosition": "auto",
      "bracketSpacing": true
    }
  },
  "html": {
    "formatter": {
      "selfCloseVoidElements": "always"
    }
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "suspicious": {
        "noUnknownAtRules": "off"
      }
    },
    "domains": {
      "next": "all",
      "react": "all"
    }
  },
  "overrides": [
    {
      "assist": {
        "actions": {
          "source": {
            "useSortedKeys": "off"
          }
        }
      },
      "includes": [
        "package.json",
        "biome.json",
        "tsconfig.json",
        ".vscode/**",
        "src/lib/parsers.ts"
      ]
    },
    {
      "linter": {
        "rules": {
          "style": {
            "useComponentExportOnlyModules": "off"
          }
        }
      },
      "includes": ["**/page.tsx", "**/layout.tsx"]
    }
  ],
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "on",
        "preset": "recommended",
        "useSortedAttributes": "on",
        "useSortedKeys": "on",
        "useSortedProperties": "on"
      }
    }
  }
}
